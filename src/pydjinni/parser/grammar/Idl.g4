grammar Idl;

idl                 : load* namespaceContent* EOF;
load                : importDef | extern;
comment             : commentLine+;
commentLine         : COMMENT;
importDef           : IMPORT filepath;
extern              : EXTERN filepath;
filepath            : FILEPATH;
namespace           : comment? NAMESPACE namespaceIdentifier LBRACE namespaceContent* RBRACE;
namespaceIdentifier : (identifier DOT)* identifier;
namespaceContent    : typeDecl | namespace;
typeDecl            : enum | flags | record | interface | namedFunction | errorDomain;
enum                : comment? identifier ASSIGN ENUM LBRACE item* RBRACE;
item                : comment? identifier SEMI;
flags               : comment? identifier ASSIGN FLAGS LBRACE flag* RBRACE;
flag                : comment? identifier modifier? SEMI;
modifier            : ASSIGN (ALL | NONE);
target              : HOST | NATIVE | SHARED;
record              : comment? identifier ASSIGN target? RECORD LBRACE field* RBRACE deriving?;
field               : comment? identifier COLON typeReference SEMI;
typeReference       : dataType | function;
dataType            : DOT? (identifier DOT)* identifier (LT (dataType COMMA)* dataType GT)? OPTIONAL?;
function            : (target? FUNCTION)? LPAREN ( (parameter COMMA)* parameter)? RPAREN throwing? (ARROW typeReference)?;
throwing            : THROWS ( (typeReference COMMA)* typeReference)?;
parameter           : identifier COLON typeReference;
deriving            : DERIVING LPAREN ((declaration COMMA)* declaration)? RPAREN;
declaration         : EQ | ORD;
interface           : comment? identifier ASSIGN target? INTERFACE LBRACE ( method | property)* RBRACE;
namedFunction       : comment? identifier ASSIGN function SEMI;
method              : comment? STATIC? CONST? ASYNC? identifier LPAREN ( (parameter COMMA)* parameter)? RPAREN throwing? (ARROW typeReference)? SEMI;
errorDomain         : comment? identifier ASSIGN ERROR LBRACE errorCode* RBRACE;
errorCode           : comment? identifier (LPAREN ((parameter)* parameter)? RPAREN)? SEMI;
property            : comment? READONLY? identifier COLON typeReference SEMI;
identifier          : ID;

IMPORT    : '@import';
EXTERN    : '@extern';
NAMESPACE : 'namespace';
ENUM      : 'enum';
FLAGS     : 'flags';
STATIC    : 'static';
CONST     : 'const';
INTERFACE : 'interface';
RECORD    : 'record';
DERIVING  : 'deriving';
FUNCTION  : 'function';
READONLY  : 'readonly';
ASYNC     : 'async';
ERROR     : 'error';
THROWS    : 'throws';
ALL       : 'all';
NONE      : 'none';
HOST      : 'host';
NATIVE    : 'native';
SHARED    : 'shared';
MAIN      : 'main';
EQ        : 'eq';
ORD       : 'ord';
ARROW     : '->';
OPTIONAL  : '?';
ASSIGN    : '=';
COLON     : ':';
LPAREN    : '(';
RPAREN    : ')';
LBRACE    : '{';
RBRACE    : '}';
GT        : '>';
LT        : '<';
SEMI      : ';';
COMMA     : ',';
DOT       : '.';
FILEPATH  : '"' .*? '"';
COMMENT   : '#' ~[\r\n]*;
WS        : [ \t\r\n]+ -> skip;
ID        : Letter LetterOrDigit*;

fragment LetterOrDigit : Letter | [0-9_];
fragment Letter        : [a-zA-Z];