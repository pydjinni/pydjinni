{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.pylance": "explicit"
        }
    },
    "python.analysis.importFormat": "absolute",
    "python.analysis.fixAll": [
        "source.convertImportFormat",
        "source.unusedImports",
    ],
    "python.analysis.typeCheckingMode": "standard",
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.autoImportCompletions": true,
    "editor.formatOnSave": true,
    "cmake.preferredGenerators": [
        "Xcode",
        "Visual Studio 17 2022",
        "Ninja",
        "Unix Makefiles"
    ],
    "cmake.configureArgs": [
        //"-DPYDJINNI_LANGUAGE_TARGETS=cpp;java;objc;cppcli",
        "-DABORT_ON_FAILED_PRECONDITION=OFF",
        "-DCMAKE_OSX_SYSROOT=macosx"
    ],
    "files.exclude": {
        ".idea/": true,
        ".fleet/": true,
        "**/__pycache__/": true,
        "**/.pytest_cache/": true,
        ".cache/": true,
    },
    "java.project.referencedLibraries": [
        "**/*.jar"
    ],
    "C_Cpp.default.cppStandard": "c++23",
    "python.useEnvironmentsExtension": true,
    "cmake.ctest.testSuiteDelimiter": "\\.",
    "cmake.ctest.testExplorerIntegrationEnabled": true,
    "cmake.ctest.allowParallelJobs": true,
    "cmake.ctest.parallelJobs": 8,
    "cmake.parallelJobs": 8,
    "antlr4.generation": {
        
        "language": "Python3",
        "mode": "internal",
        "listeners": true,
        "visitors": false
    },
    "isort.check": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "isort.importStrategy": "useBundled",
}
