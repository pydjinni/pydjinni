{
    // General editor settings
    "editor.formatOnSave": true,

    // Python editor settings
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },

    // Python analysis and testing
    "python.languageServer": "Pylance",
    "python.analysis.importFormat": "absolute",
    "python.analysis.fixAll": [
        "source.convertImportFormat",
        "source.unusedImports",
    ],
    "python.testing.pytestArgs": [
        "tests",
        "-vv"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.autoImportCompletions": true,
    "python.useEnvironmentsExtension": true,

    // File explorer
    "files.exclude": {
        ".idea/": true,
        ".fleet/": true,
        "**/__pycache__/": true,
        "**/.pytest_cache/": true,
        ".cache/": true,
    },

    // Java
    "java.project.referencedLibraries": [
        "**/*.jar"
    ],

    // C and C++
    "C_Cpp.default.cppStandard": "c++23",

    // CMake
    "cmake.ctest.testSuiteDelimiter": "\\.",
    "cmake.ctest.testExplorerIntegrationEnabled": true,
    "cmake.ctest.allowParallelJobs": true,
    "cmake.ctest.parallelJobs": 8,
    "cmake.parallelJobs": 8,
    "cmake.preferredGenerators": [
        "Xcode",
        "Visual Studio 17 2022",
        "Ninja",
        "Unix Makefiles"
    ],
    "cmake.configureArgs": [
        "-DPYDJINNI_LANGUAGE_TARGETS=cpp;java;objc",
        "-DABORT_ON_FAILED_PRECONDITION=OFF",
        "-DCMAKE_OSX_SYSROOT=macosx",
        "-DDJINNI_EXECUTABLE=/Users/johannes/Git/github/pydjinni/pydjinni/.venv/bin/pydjinni"
    ],

    // ANTLR
    "antlr4.generation": {
        "language": "Python3",
        "mode": "internal",
    },
    "antlr4.format": {
        "alignTrailingComments": false,
        "allowShortBlocksOnASingleLine": true,
        "breakBeforeBraces": false,
        "columnLimit": 300,
        "continuationIndentWidth": 4,
        "indentWidth": 4,
        "keepEmptyLinesAtTheStartOfBlocks": false,
        "maxEmptyLinesToKeep": 1,
        "reflowComments": true,
        "spaceBeforeAssignmentOperators": true,
        "tabWidth": 4,
        "useTab": false,
        "alignColons": "trailing",
        "singleLineOverrulesHangingColon": true,
        "allowShortRulesOnASingleLine": true,
        "alignSemicolons": "none",
        "breakBeforeParens": false,
        "ruleInternalsOnSingleLine": false,
        "minEmptyLines": 0,
        "groupedAlignments": true,
        "alignFirstTokens": false,
        "alignLexerCommands": false,
        "alignActions": false,
        "alignLabels": true,
        "alignTrailers": false,
    },

    // Generate the Python sources with a relative source path in the header
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "Idl\\.g4$",
                "cmd": "cd \"${fileDirname}\" && antlr4 -v 4.13.2 -Dlanguage=Python3 -visitor -no-listener Idl.g4",
                "autoShowOutputPanel": "error"
            }
        ]
    },

    // ANTLR editor integration
    "[antlr]": {
        "editor.defaultFormatter": "mike-lischke.vscode-antlr4"
    },
}
